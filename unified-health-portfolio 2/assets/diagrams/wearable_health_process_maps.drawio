        <mxCell id="je4" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#748293;fontSize=12;fontColor=#566575;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="j4" target="j5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="je5" value="No / partial" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#748293;fontSize=12;fontColor=#566575;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="j4" target="j8">
